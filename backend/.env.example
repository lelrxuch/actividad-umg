PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sis_db
DB_USER=postgres
DB_PASSWORD=tu_password
JWT_SECRET=cambia_este_valor
JWT_EXPIRES_IN=1h
RESET_TOKEN_EXPIRES_MIN=30

# development | production - en produccion SIEMPRE debe ir 'production'
NODE_ENV=development

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Dominios de correo institucional aceptados en registro y login, separados por coma.
# Es la única lista del proyecto: el frontend no valida dominios, muestra el error del backend.
ALLOWED_EMAIL_DOMAINS=miumg.edu.gt,mineduc.gob.gt,usac.edu.gt