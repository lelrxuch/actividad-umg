    {
      "name": "PUT /api/usuarios/:id/perfil - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Devuelve mensaje de éxito', () => {",
              "  pm.expect(pm.response.json()).to.have.property('mensaje');",
              "});",
              "",
              "pm.test('Devuelve el usuario actualizado', () => {",
              "  const usuario = pm.response.json().usuario;",
              "  pm.expect(usuario).to.be.an('object');",
              "  pm.expect(usuario).to.have.property('nombre', 'Juan Pérez Actualizado');",
              "});",
              "",
              "// El controller desestructura correoAlterno (camelCase) del body, pero la",
              "// columna en la base se llama correo_alterno. Esta aserción comprueba que el",
              "// valor realmente llegó hasta la base: si alguien cambia el nombre del campo",
              "// en un lado y no en el otro, la prueba falla en vez de pasar en falso.",
              "pm.test('El correo alterno sí se guardó', () => {",
              "  const usuario = pm.response.json().usuario;",
              "  pm.expect(usuario.correo_alterno).to.eql('juan.nuevo@miumg.edu.gt');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nombre\": \"Juan Pérez Actualizado\",\r\n  \"telefono\": \"87654321\",\r\n  \"correoAlterno\": \"juan.nuevo@miumg.edu.gt\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
