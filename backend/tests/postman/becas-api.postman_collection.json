    {
      "name": "PUT /api/usuarios/:id/perfil - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Devuelve mensaje de éxito', () => {",
              "  pm.expect(pm.response.json()).to.have.property('mensaje');",
              "});",
              "",
              "pm.test('Devuelve objeto usuario actualizado', () => {",
              "  pm.expect(pm.response.json()).to.have.property('usuario');",
              "  pm.expect(pm.response.json().usuario).to.have.property('nombre');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
